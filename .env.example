# Django Core
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
USE_SQLITE=True

# PostgreSQL (set USE_SQLITE=False in production)
DB_NAME=toyxona_db
DB_USER=postgres
DB_PASSWORD=replace-with-database-password
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Celery & Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Telegram
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=generate-a-random-secret
SITE_URL=http://localhost:8000

# JWT Security (Access token 15 min, Refresh token 7 days)
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# CORS / CSRF (comma-separated)
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security Headers (Set SECURE_HSTS_SECONDS=31536000 for production HTTPS)
SECURE_HSTS_SECONDS=0
SECURE_SSL_REDIRECT=False
